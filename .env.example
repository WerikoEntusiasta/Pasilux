# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===================================================================
# CONFIGURAÇÃO DE ENVIO DE E-MAILS (FORMULÁRIOS DE CONTATO E ORÇAMENTO)
# ===================================================================
# Servidor SMTP (ex: smtp.gmail.com, smtp.hostinger.com, smtp.titan.email, smtp.zoho.com, smtp.sendgrid.net, smtp.resend.com)
SMTP_HOST=smtp.gmail.com

# Porta SMTP (587 para TLS/STARTTLS, 465 para SSL/TLS)
SMTP_PORT=587

# Segurança: true para porta 465 (SSL), false para porta 587 (STARTTLS)
SMTP_SECURE=false

# Usuário / E-mail de autenticação no servidor SMTP
SMTP_USER=seu-email@dominio.com.br

# Senha do SMTP ou Senha de Aplicativo (App Password no Gmail/Google Workspace)
SMTP_PASS=sua-senha-de-aplicativo

# Remetente visível do e-mail
EMAIL_FROM="Pasilux Perfis LED <contato@pasilux.com.br>"

# Destinatário principal que receberá os formulários preenchidos
EMAIL_TO=contato@pasilux.com.br

# E-mail em cópia (opcional, pode deixar vazio ou separar por vírgula)
EMAIL_CC=

